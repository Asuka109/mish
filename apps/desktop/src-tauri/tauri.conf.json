{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mish",
  "version": "0.1.0",
  "identifier": "com.asuka109.mish",
  "build": {
    "beforeBuildCommand": "pnpm --dir ../.. --filter @mish/web build:desktop",
    "beforeDevCommand": "pnpm --dir ../.. --filter @mish/web build:desktop && pnpm --dir ../.. --filter @mish/web dev:desktop",
    "devUrl": "http://127.0.0.1:4173",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "center": true,
        "decorations": true,
        "devtools": false,
        "height": 760,
        "hiddenTitle": true,
        "label": "main",
        "minHeight": 600,
        "minWidth": 800,
        "resizable": true,
        "title": "Mish",
        "titleBarStyle": "Overlay",
        "transparent": true,
        "visible": false,
        "useHttpsScheme": true,
        "width": 1160
      }
    ],
    "security": {
      "capabilities": ["main"],
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:*; font-src 'self'; frame-src 'none'; img-src 'self' data: https:; object-src 'none'; style-src 'self' 'unsafe-inline'; base-uri 'none'; form-action 'none'",
      "headers": {
        "Cross-Origin-Resource-Policy": "same-origin",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=()"
      }
    }
  },
  "bundle": {
    "active": true,
    "category": "Utility",
    "copyright": "Copyright © 2026 Asuka109 and Mish contributors",
    "icon": [
      "../../../packages/brand-assets/generated/tauri/32x32.png",
      "../../../packages/brand-assets/generated/tauri/128x128.png",
      "../../../packages/brand-assets/generated/tauri/128x128@2x.png",
      "../../../packages/brand-assets/generated/tauri/icon.icns",
      "../../../packages/brand-assets/generated/tauri/icon.ico"
    ],
    "macOS": {
      "hardenedRuntime": true,
      "minimumSystemVersion": "13.0"
    },
    "targets": ["app"]
  }
}
