{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mish",
  "version": "0.1.0",
  "identifier": "com.asuka109.mish",
  "build": {
    "beforeBuildCommand": "pnpm --dir ../.. --filter @mish/web build",
    "beforeDevCommand": "pnpm --dir ../.. --filter @mish/web dev",
    "devUrl": "http://127.0.0.1:4173",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "center": true,
        "decorations": true,
        "height": 760,
        "hiddenTitle": true,
        "label": "main",
        "minHeight": 600,
        "minWidth": 800,
        "resizable": true,
        "title": "Mish",
        "titleBarStyle": "Overlay",
        "transparent": true,
        "visible": false,
        "useHttpsScheme": true,
        "width": 1160
      }
    ],
    "security": {
      "capabilities": ["main"],
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:*; font-src 'self'; frame-src 'none'; img-src 'self' data:; object-src 'none'; style-src 'self' 'unsafe-inline'; base-uri 'none'; form-action 'none'",
      "headers": {
        "Cross-Origin-Resource-Policy": "same-origin",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=()"
      }
    }
  },
  "bundle": {
    "active": true,
    "category": "Utility",
    "icon": ["icons/icon.png"],
    "macOS": {
      "hardenedRuntime": true,
      "minimumSystemVersion": "13.0"
    },
    "resources": {
      "../../../.scratch/mihomo/v1.19.29/mihomo-darwin-arm64-v1.19.29": "mihomo-aarch64-apple-darwin",
      "../../web/dist/": "web-dist/"
    },
    "targets": ["app"]
  }
}
