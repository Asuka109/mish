{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Allows Mish bootstrap, user-selected profile import, and native title-bar gestures in the main local WebView.",
  "local": true,
  "windows": ["main"],
  "permissions": [
    "allow-runtime-bootstrap",
    "allow-profile-preflight-local",
    "core:window:allow-start-dragging",
    "core:window:allow-toggle-maximize"
  ]
}
