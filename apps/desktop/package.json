{
  "name": "@mish/desktop",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-only",
  "scripts": {
    "build": "tauri build --no-bundle --features custom-protocol",
    "bundle:macos": "tauri build --bundles app --features custom-protocol --config src-tauri/tauri.bundle.conf.json --config src-tauri/tauri.bundle.signed-core.conf.json",
    "bundle:macos:internal-tun-alpha": "tauri build --bundles app --features custom-protocol,development-core-host --config src-tauri/tauri.bundle.conf.json --config src-tauri/tauri.bundle.pinned-core.conf.json",
    "bundle:macos:alpha-ad-hoc": "tauri build --bundles app --features custom-protocol --config src-tauri/tauri.bundle.conf.json --config src-tauri/tauri.bundle.signed-core.conf.json",
    "bundle:macos:production": "tauri build --bundles app --features custom-protocol --config src-tauri/tauri.bundle.conf.json --config src-tauri/tauri.bundle.signed-core.conf.json --config src-tauri/tauri.production.conf.json",
    "bundle:macos:signed-direct": "tauri build --bundles app --features custom-protocol --config src-tauri/tauri.bundle.conf.json --config src-tauri/tauri.bundle.signed-core.conf.json --config src-tauri/tauri.signed-direct.conf.json",
    "demo": "node --env-file=.env.development ../../scripts/tauri-dev.ts --demo",
    "dev": "node --env-file=.env.development ../../scripts/tauri-dev.ts",
    "test:run": "cargo test --manifest-path src-tauri/Cargo.toml",
    "typecheck": "cargo check --manifest-path src-tauri/Cargo.toml"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4"
  }
}
