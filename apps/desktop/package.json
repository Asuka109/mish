{
  "name": "@mish/desktop",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tauri build --no-bundle --features custom-protocol",
    "bundle:macos": "tauri build --bundles app --features custom-protocol --config src-tauri/tauri.bundle.conf.json",
    "bundle:macos:production": "tauri build --bundles app --features custom-protocol --config src-tauri/tauri.bundle.conf.json --config src-tauri/tauri.production.conf.json",
    "demo": "node ../../scripts/tauri-dev.ts --demo",
    "dev": "node ../../scripts/tauri-dev.ts",
    "test:run": "cargo test --manifest-path src-tauri/Cargo.toml",
    "typecheck": "cargo check --manifest-path src-tauri/Cargo.toml"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4"
  }
}
