{
  "$schema": "../gen/schemas/mobile-schema.json",
  "identifier": "mobile",
  "description": "Allows the mobile WebView to use the bounded bootstrap and native VPN lifecycle projection.",
  "local": true,
  "windows": ["main"],
  "platforms": ["android", "iOS"],
  "permissions": [
    "allow-mobile-fixture-bootstrap",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "mish-vpn:default"
  ]
}
