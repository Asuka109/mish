{
  "$schema": "../gen/schemas/mobile-schema.json",
  "identifier": "mobile-settings-android",
  "description": "Allows the Android WebView to read Shared Rust Settings and mutate only portable appearance and language preferences.",
  "local": true,
  "windows": ["main"],
  "platforms": ["android"],
  "permissions": [
    "allow-mobile-settings-get-snapshot",
    "allow-mobile-settings-set-appearance",
    "allow-mobile-settings-set-language"
  ]
}
