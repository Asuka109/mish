{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "jsx": "react-native",
    "lib": ["ES2024"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2024",
    "types": ["node", "react", "react-native", "vitest/globals"]
  },
  "include": ["index.ts", "src", "scripts", "tests"]
}
