{
  "schemaVersion": 1,
  "workspaceRoots": [
    { "prefix": "apps/desktop/", "family": "desktop-macos" },
    { "prefix": "apps/mobile/", "family": "mobile-android" },
    { "prefix": "crates/platform-", "family": "platform-macos" },
    { "prefix": "crates/simulated-host/", "family": "simulated-host" }
  ],
  "packages": [
    {
      "name": "mish-desktop",
      "manifest": "apps/desktop/src-tauri/Cargo.toml",
      "family": "desktop-macos",
      "targets": ["aarch64-apple-darwin"],
      "runner": "macos-15",
      "workflow": ".github/workflows/ci.yml",
      "job": "platform-macos-gate",
      "checkScript": "check:rust:desktop",
      "testScript": "test:rust:desktop",
      "testMode": "run",
      "hostLimitation": "Native macOS target checks run on the hosted ARM64 runner; no application launch or host mutation is performed.",
      "compileCommands": [
        "cargo check -p mish-desktop --all-targets --all-features --target aarch64-apple-darwin"
      ],
      "clippyCommands": [
        "cargo clippy -p mish-desktop --all-targets --all-features --target aarch64-apple-darwin -- -D warnings"
      ],
      "testCommands": [
        "cargo test -p mish-desktop --all-features --target aarch64-apple-darwin --lib -- --test-threads=1"
      ]
    },
    {
      "name": "mish-mobile",
      "manifest": "apps/mobile/src-tauri/Cargo.toml",
      "family": "mobile-android",
      "targets": ["aarch64-linux-android", "x86_64-linux-android"],
      "runner": "ubuntu-24.04",
      "workflow": ".github/workflows/ci.yml",
      "job": "platform-android-gate",
      "checkScript": "check:rust:mobile",
      "testScript": "test:rust:mobile",
      "testMode": "compile-only",
      "hostLimitation": "Android target tests compile with the pinned NDK linker but do not execute without a device or emulator.",
      "compileCommands": [
        "cargo check -p mish-mobile --all-targets --target aarch64-linux-android",
        "cargo check -p mish-mobile --all-targets --target x86_64-linux-android"
      ],
      "clippyCommands": [
        "cargo clippy -p mish-mobile --all-targets --target aarch64-linux-android -- -D warnings",
        "cargo clippy -p mish-mobile --all-targets --target x86_64-linux-android -- -D warnings"
      ],
      "testCommands": [
        "cargo test -p mish-mobile --target aarch64-linux-android --lib --no-run",
        "cargo test -p mish-mobile --target x86_64-linux-android --lib --no-run"
      ]
    },
    {
      "name": "tauri-plugin-mish-vpn",
      "manifest": "apps/mobile/src-tauri/plugins/mish-vpn/Cargo.toml",
      "family": "mobile-android",
      "targets": ["aarch64-linux-android", "x86_64-linux-android"],
      "runner": "ubuntu-24.04",
      "workflow": ".github/workflows/ci.yml",
      "job": "platform-android-gate",
      "checkScript": "check:rust:mobile",
      "testScript": "test:rust:mobile",
      "testMode": "compile-only",
      "hostLimitation": "Android target tests compile with the pinned NDK linker but do not execute without a device or emulator.",
      "compileCommands": [
        "cargo check -p tauri-plugin-mish-vpn --all-targets --target aarch64-linux-android",
        "cargo check -p tauri-plugin-mish-vpn --all-targets --target x86_64-linux-android"
      ],
      "clippyCommands": [
        "cargo clippy -p tauri-plugin-mish-vpn --all-targets --target aarch64-linux-android -- -D warnings",
        "cargo clippy -p tauri-plugin-mish-vpn --all-targets --target x86_64-linux-android -- -D warnings"
      ],
      "testCommands": [
        "cargo test -p tauri-plugin-mish-vpn --target aarch64-linux-android --lib --no-run",
        "cargo test -p tauri-plugin-mish-vpn --target x86_64-linux-android --lib --no-run"
      ]
    },
    {
      "name": "mish-platform-macos",
      "manifest": "crates/platform-macos/Cargo.toml",
      "family": "platform-macos",
      "targets": ["aarch64-apple-darwin"],
      "runner": "macos-15",
      "workflow": ".github/workflows/ci.yml",
      "job": "platform-macos-gate",
      "checkScript": "check:rust:platform-macos",
      "testScript": "test:rust:platform-macos",
      "testMode": "run",
      "hostLimitation": "Platform tests use repository fixtures and temporary paths; no System Proxy, TUN, Core, or network effect is admitted.",
      "compileCommands": [
        "cargo check -p mish-platform-macos --all-targets --all-features --target aarch64-apple-darwin"
      ],
      "clippyCommands": [
        "cargo clippy -p mish-platform-macos --all-targets --all-features --target aarch64-apple-darwin -- -D warnings"
      ],
      "testCommands": [
        "cargo test -p mish-platform-macos --all-features --target aarch64-apple-darwin --tests -- --test-threads=1"
      ]
    },
    {
      "name": "mish-simulated-host",
      "manifest": "crates/simulated-host/Cargo.toml",
      "family": "simulated-host",
      "targets": ["host"],
      "runner": "ubuntu-24.04",
      "workflow": ".github/workflows/ci.yml",
      "job": "pr-gate",
      "checkScript": "check:rust:simulated-host",
      "testScript": "test:application:simulated-host",
      "testMode": "run",
      "hostLimitation": "The shared host is an in-memory, test-only model; browser and Rust evidence cannot claim real macOS, TUN, Core, or network behavior.",
      "compileCommands": ["cargo check -p mish-simulated-host --all-targets --all-features"],
      "clippyCommands": [
        "cargo clippy -p mish-simulated-host --all-targets --all-features -- -D warnings"
      ],
      "testCommands": ["cargo test -p mish-simulated-host --all-features -- --test-threads=1"]
    }
  ],
  "workflowCoverage": [
    {
      "workflow": ".github/workflows/ci.yml",
      "job": "pr-gate",
      "if": "github.event_name == 'pull_request'",
      "runner": "ubuntu-24.04",
      "commands": ["pnpm check:pr"],
      "scriptRequirements": {
        "check:pr": ["pnpm check:rust:simulated-host", "pnpm test:application:simulated-host"],
        "test:application:simulated-host": [
          "cargo test -p mish-simulated-host --all-features -- --test-threads=1"
        ]
      }
    },
    {
      "workflow": ".github/workflows/ci.yml",
      "job": "platform-macos-gate",
      "if": "github.event_name == 'schedule' || (github.event_name == 'workflow_dispatch' && (inputs.task == 'inspection' || inputs.task == 'all'))",
      "runner": "macos-15",
      "commands": [
        "pnpm --filter @mish/web build:desktop",
        "pnpm check:rust:desktop",
        "pnpm test:rust:desktop",
        "pnpm check:rust:platform-macos",
        "pnpm test:rust:platform-macos"
      ],
      "scriptRequirements": {}
    },
    {
      "workflow": ".github/workflows/ci.yml",
      "job": "platform-android-gate",
      "if": "github.event_name == 'pull_request'",
      "runner": "ubuntu-24.04",
      "commands": ["pnpm check:rust:mobile", "pnpm test:rust:mobile"],
      "scriptRequirements": {}
    }
  ]
}
