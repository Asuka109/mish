{
  "name": "mish",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "build": "pnpm web:build",
    "check": "pnpm check:pr",
    "check:admission": "node scripts/check-typescript-cutover-admission.ts",
    "check:all": "pnpm check:pr",
    "check:ci": "node scripts/check-ci-workflow.ts",
    "check:design": "pnpm dlx @google/design.md lint DESIGN.md",
    "check:docs": "node scripts/check-markdown-links.ts && node scripts/check-documentation-trackers.ts",
    "check:format": "oxfmt --check .github .out-of-scope package.json pnpm-workspace.yaml tsconfig.json apps packages scripts resources README.md README.zh-CN.md PRODUCT.md CONTRIBUTING.md THIRD_PARTY_NOTICES.md docs",
    "check:graph": "node scripts/check-production-retirement.ts",
    "check:i18n": "node scripts/check-i18n-generated.ts",
    "check:lint": "oxlint apps packages scripts && node scripts/check-oxlint-config.ts",
    "check:pr": "pnpm check:admission && pnpm check:graph && pnpm poc:admission && pnpm check:ci && pnpm check:i18n && pnpm check:lint && pnpm check:styles && pnpm check:format && pnpm check:types && pnpm test:unit && pnpm check:tokens && pnpm check:docs && pnpm web:build && pnpm desktop:check && pnpm mobile:check",
    "check:styles": "node scripts/check-tailwind-sources.ts",
    "check:tokens": "node scripts/check-design-tokens.ts",
    "check:types": "pnpm check:types:ts && pnpm --filter @mish/desktop typecheck && pnpm --filter @mish/mobile rn:typecheck",
    "check:types:ts": "pnpm --filter @mish/contracts --filter @mish/domain --filter @mish/orpc-client --filter @mish/ui-state --filter @mish/ui --filter @mish/web typecheck",
    "ci:check": "pnpm check:ci",
    "desktop:build": "pnpm --filter @mish/desktop build",
    "desktop:bundle:fixture": "pnpm --filter @mish/desktop fixture:build",
    "desktop:check": "pnpm --filter @mish/desktop typecheck && pnpm --filter @mish/desktop test:run",
    "desktop:test": "pnpm --filter @mish/desktop test:run",
    "desktop:typecheck": "pnpm --filter @mish/desktop typecheck",
    "dev": "pnpm web:dev",
    "format": "oxfmt --write .github .out-of-scope package.json pnpm-workspace.yaml tsconfig.json apps packages scripts resources README.md README.zh-CN.md PRODUCT.md CONTRIBUTING.md THIRD_PARTY_NOTICES.md docs",
    "generate:brand": "node scripts/generate-brand-assets.ts",
    "generate:i18n": "pnpm --filter @mish/web i18n:generate",
    "lint": "pnpm check:lint",
    "mobile:android:build": "pnpm --filter @mish/mobile rn:android:build",
    "mobile:android:smoke": "pnpm --filter @mish/mobile rn:android:smoke",
    "mobile:check": "pnpm --filter @mish/mobile rn:typecheck && pnpm --filter @mish/mobile rn:test:run",
    "preview": "pnpm web:preview",
    "test": "pnpm test:watch",
    "test:run": "pnpm test:unit",
    "test:scripts": "node --test scripts/check-documentation-trackers.test.ts scripts/check-oxlint-config.test.ts scripts/check-typescript-cutover-admission.test.ts scripts/macos-dmg-presentation.test.ts scripts/release-path-containment.test.ts",
    "test:transcript": "pnpm --filter @mish/domain test:run && pnpm --filter @mish/orpc-client test:run && pnpm --filter @mish/ui-state test:run",
    "test:ts": "pnpm test:unit",
    "test:unit": "pnpm --filter @mish/domain --filter @mish/orpc-client --filter @mish/ui-state --filter @mish/web test:run && pnpm test:scripts",
    "test:watch": "pnpm web:test",
    "tokens:check": "pnpm check:tokens",
    "typecheck": "pnpm check:types",
    "typecheck:ts": "pnpm check:types:ts",
    "validate": "pnpm check:all",
    "validate:pr": "pnpm check:pr",
    "web:build": "pnpm --filter @mish/web build",
    "web:dev": "pnpm --filter @mish/web dev",
    "web:preview": "pnpm --filter @mish/web preview",
    "web:test": "pnpm --filter @mish/web test",
    "web:test:run": "pnpm --filter @mish/web test:run",
    "poc:admission": "node scripts/check-poc-admission.ts"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@types/ws": "8.18.1",
    "oxfmt": "0.59.0",
    "oxlint": "1.74.0",
    "typescript": "7.0.2",
    "ws": "8.21.1",
    "yaml": "2.9.0"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@11.13.1"
}
